# Clean Zsh config

export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt appendhistory
setopt sharehistory
setopt hist_ignore_dups
setopt hist_ignore_space

# Completion
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# Prompt timestamp + command duration
autoload -Uz add-zsh-hook

_command_start_time=0

preexec() {
  _command_start_time=$EPOCHSECONDS
}

precmd() {
  local exit_code=$?
  local now_time
  local duration

  now_time=$(date '+%H:%M:%S')

  if [[ $_command_start_time -gt 0 ]]; then
    duration=$(( EPOCHSECONDS - _command_start_time ))

    if [[ $duration -ge 1 ]]; then
      export CMD_DURATION_TEXT=" ⏱ ${duration}s"
    else
      export CMD_DURATION_TEXT=""
    fi
  else
    export CMD_DURATION_TEXT=""
  fi

  export PROMPT_TIME_TEXT="$now_time"
  _command_start_time=0
}

# Starship prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
else
  PROMPT='%F{cyan}%~%f ${CMD_DURATION_TEXT}
❯ '
  RPROMPT='%F{244}${PROMPT_TIME_TEXT}%f'
fi

# fzf
if [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
  source /usr/share/doc/fzf/examples/key-bindings.zsh
fi

if [[ -f /usr/share/doc/fzf/examples/completion.zsh ]]; then
  source /usr/share/doc/fzf/examples/completion.zsh
fi

# zsh autosuggestions
if [[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# zsh syntax highlighting: must be loaded near the end
if [[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi

# zoxide
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"

# NVM
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"

# Aliases
command -v eza >/dev/null 2>&1 && alias ls='eza --icons=auto'
command -v eza >/dev/null 2>&1 && alias ll='eza -lah --icons=auto'
command -v eza >/dev/null 2>&1 && alias la='eza -a --icons=auto'
command -v batcat >/dev/null 2>&1 && alias cat='batcat'
command -v bat >/dev/null 2>&1 && alias cat='bat'

